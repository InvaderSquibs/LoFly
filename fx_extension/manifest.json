{
  "manifest_version": 3,
  "name": "FX · Fly Experience",
  "version": "0.1.0",
  "description": "Gherkin QA on any page — a fly finds elements by nearest-neighbor perception and clicks, types, and asserts.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open FX side panel",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fly_topdown.gif"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
